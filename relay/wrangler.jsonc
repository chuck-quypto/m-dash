{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "m-dash-relay-dev",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "limits": { "cpu_ms": 10 },
  "d1_databases": [{ "binding": "DB", "database_name": "m-dash-relay-dev", "database_id": "00000000-0000-0000-0000-000000000000" }],
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }],
  "triggers": { "crons": ["0 * * * *"] }
}
