{
  "$description": "Source of truth for CND design tokens. Edit here, then run `npm run build`. Every generated CSS variable is prefixed --cnd-.",

  "color": {
    "dark": {
      "bg": "#0A0C10",
      "surface": "#131820",
      "surface-raised": "#1A202A",
      "surface-sunken": "#06080B",
      "glass": "rgba(19, 24, 32, 0.72)",
      "line": "#222A35",
      "line-strong": "#2E3846",
      "line-input": "#5B6778",
      "fg": "#EEF2F6",
      "fg-muted": "#AEB8C6",
      "fg-subtle": "#8A96A6",
      "accent": "#22D3EE",
      "accent-hover": "#67E8F9",
      "on-accent": "#04141A",
      "accent-soft": "rgba(34, 211, 238, 0.12)",
      "accent-text": "#67E8F9",
      "beam": "#22D3EE",
      "info": "#60A5FA",
      "info-soft": "rgba(59, 130, 246, 0.14)",
      "success": "#34D399",
      "success-soft": "rgba(52, 211, 153, 0.12)",
      "warning": "#F5B544",
      "warning-soft": "rgba(245, 181, 68, 0.12)",
      "danger": "#F7848C",
      "danger-soft": "rgba(242, 98, 107, 0.14)",
      "focus": "#67E8F9",
      "glow-color": "rgba(34, 211, 238, 0.32)",
      "ambient-color": "rgba(34, 211, 238, 0.07)"
    },
    "light": {
      "bg": "#F6F7F9",
      "surface": "#FFFFFF",
      "surface-raised": "#FFFFFF",
      "surface-sunken": "#EDEFF2",
      "glass": "rgba(255, 255, 255, 0.86)",
      "line": "#D9DEE4",
      "line-strong": "#C2CAD3",
      "line-input": "#7E8995",
      "fg": "#12181F",
      "fg-muted": "#3F4A55",
      "fg-subtle": "#5E6A76",
      "accent": "#1F4FD1",
      "accent-hover": "#163A9C",
      "on-accent": "#FFFFFF",
      "accent-soft": "#E8EEFC",
      "accent-text": "#1F4FD1",
      "beam": "#1F4FD1",
      "info": "#2C5A6E",
      "info-soft": "#E3EEF2",
      "success": "#1E7A55",
      "success-soft": "#E2F3EC",
      "warning": "#9A4E12",
      "warning-soft": "#FBEFE3",
      "danger": "#B42335",
      "danger-soft": "#FBE6E9",
      "focus": "#1F4FD1",
      "glow-color": "rgba(31, 79, 209, 0.14)",
      "ambient-color": "rgba(31, 79, 209, 0.00)"
    }
  },

  "style": {
    "product": {
      "font-display": "\"Space Grotesk\", ui-sans-serif, system-ui, sans-serif",
      "font-body": "\"Geist\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "font-reading": "\"Geist\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "font-mono": "\"Geist Mono\", ui-monospace, \"Cascadia Code\", Menlo, monospace",
      "radius-xs": "4px",
      "radius-sm": "6px",
      "radius-md": "10px",
      "radius-lg": "14px",
      "radius-xl": "20px",
      "radius-2xl": "28px"
    },
    "editorial": {
      "font-display": "\"Instrument Sans\", ui-sans-serif, system-ui, sans-serif",
      "font-body": "\"Instrument Sans\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "font-reading": "\"Source Serif 4\", Georgia, \"Times New Roman\", serif",
      "font-mono": "\"IBM Plex Mono\", ui-monospace, \"Cascadia Code\", Menlo, monospace",
      "radius-xs": "2px",
      "radius-sm": "4px",
      "radius-md": "6px",
      "radius-lg": "8px",
      "radius-xl": "10px",
      "radius-2xl": "14px"
    }
  },

  "intensity": {
    "quiet": {
      "glow": "none",
      "glow-strong": "none",
      "ambient": "none"
    },
    "standard": {
      "glow": "0 0 24px var(--cnd-glow-color)",
      "glow-strong": "0 0 28px var(--cnd-glow-color), 0 0 2px var(--cnd-glow-color)",
      "ambient": "radial-gradient(900px 520px at 0% 0%, var(--cnd-ambient-color), transparent 60%)"
    },
    "expressive": {
      "glow": "0 0 20px var(--cnd-glow-color), 0 0 56px var(--cnd-glow-color)",
      "glow-strong": "0 0 24px var(--cnd-glow-color), 0 0 72px var(--cnd-glow-color), 0 0 2px var(--cnd-glow-color)",
      "ambient": "radial-gradient(900px 520px at 0% 0%, var(--cnd-ambient-color), transparent 60%), radial-gradient(700px 480px at 100% 100%, var(--cnd-ambient-color), transparent 60%)"
    }
  },

  "shadow": {
    "dark": {
      "shadow-sm": "0 1px 2px rgba(0, 0, 0, 0.40)",
      "shadow-md": "0 8px 24px rgba(0, 0, 0, 0.35)",
      "shadow-lg": "0 20px 48px rgba(0, 0, 0, 0.45)"
    },
    "light": {
      "shadow-sm": "0 1px 2px rgba(18, 24, 31, 0.06)",
      "shadow-md": "0 8px 24px rgba(18, 24, 31, 0.08)",
      "shadow-lg": "0 20px 48px rgba(18, 24, 31, 0.12)"
    }
  },

  "text": {
    "xs": ["0.75rem", "calc(1 / 0.75)"],
    "dense": ["0.8125rem", "calc(1.25 / 0.8125)"],
    "sm": ["0.875rem", "calc(1.25 / 0.875)"],
    "md": ["0.875rem", "calc(1.25 / 0.875)"],
    "base": ["1rem", "calc(1.5 / 1)"],
    "lg": ["1.125rem", "calc(1.75 / 1.125)"],
    "xl": ["1.25rem", "calc(1.75 / 1.25)"],
    "2xl": ["1.5rem", "calc(2 / 1.5)"],
    "3xl": ["1.875rem", "calc(2.25 / 1.875)"],
    "4xl": ["2.25rem", "calc(2.5 / 2.25)"],
    "5xl": ["3rem", "1"],
    "6xl": ["3.75rem", "1"]
  },

  "static": {
    "weight-regular": "400",
    "weight-medium": "500",
    "weight-semibold": "600",
    "weight-bold": "700",
    "tracking-display": "-0.03em",
    "tracking-tight": "-0.015em",
    "tracking-label": "0.1em",
    "space-0": "0",
    "space-1": "4px",
    "space-2": "8px",
    "space-3": "12px",
    "space-4": "16px",
    "space-5": "20px",
    "space-6": "24px",
    "space-8": "32px",
    "space-10": "40px",
    "space-12": "48px",
    "space-16": "64px",
    "space-20": "80px",
    "radius-pill": "9999px",
    "glass-blur": "16px",
    "duration-fast": "120ms",
    "duration-base": "200ms",
    "duration-slow": "320ms",
    "ease-standard": "cubic-bezier(0.2, 0, 0, 1)",
    "ease-emphasized": "cubic-bezier(0.16, 1, 0.3, 1)",
    "measure": "68ch"
  },

  "fonts": {
    "product": "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap",
    "editorial": "https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=IBM+Plex+Mono:wght@400;500&display=swap"
  },

  "checks": {
    "$description": "WCAG contrast floors enforced by the build, per theme. [foreground, background, minimum]. A translucent background is composited over 'surface'.",
    "pairs": [
      ["fg", "bg", 7],
      ["fg", "surface", 7],
      ["fg-muted", "bg", 4.5],
      ["fg-muted", "surface", 4.5],
      ["fg-subtle", "bg", 4.5],
      ["fg-subtle", "surface", 4.5],
      ["fg-subtle", "surface-raised", 4.5],
      ["fg-subtle", "surface-sunken", 4.5],
      ["accent-text", "bg", 4.5],
      ["accent-text", "surface", 4.5],
      ["accent-text", "accent-soft", 4.5],
      ["on-accent", "accent", 4.5],
      ["on-accent", "accent-hover", 4.5],
      ["info", "bg", 4.5],
      ["info", "info-soft", 4.5],
      ["success", "bg", 4.5],
      ["success", "success-soft", 4.5],
      ["warning", "bg", 4.5],
      ["warning", "warning-soft", 4.5],
      ["danger", "bg", 4.5],
      ["danger", "danger-soft", 4.5],
      ["line-input", "surface", 3],
      ["line-input", "bg", 3],
      ["focus", "bg", 3],
      ["focus", "surface", 3]
    ]
  }
}
